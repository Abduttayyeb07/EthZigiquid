NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false
NEXT_PUBLIC_API_URL=http://localhost:4000
CONTROL_API_TOKEN=choose-your-operator-token
STATE_ENCRYPTION_KEY=replace-with-64-hex-characters
PERSIST_RUNTIME_STATE=false

# Docker host ports. Container-internal ports remain 3000 (web) and 4000 (API).
DOCKER_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=18300
API_HOST_PORT=18400
DOCKER_WEB_ORIGIN=http://localhost:18300
DOCKER_PUBLIC_API_URL=http://localhost:18400
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Real Ethereum mainnet swaps; the backend signs and submits transactions directly.
EXECUTION_MODE=live
DATABASE_URL=postgresql://zig:zig_dev_password@localhost:5432/zig_automation

ZIG_TOKEN_ADDRESS=0xb2617246d0c6c0087f18703d576831899ca94f01
NEXT_PUBLIC_ZIG_TOKEN_ADDRESS=0xb2617246d0c6c0087f18703d576831899ca94f01
UNISWAP_V2_ROUTER_ADDRESS=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
ALCHEMY_RPC_URL=
ETHERSCAN_API_KEY=

RPC_HTTP_URLS=https://eth.llamarpc.com,https://ethereum.publicnode.com,https://rpc.ankr.com/eth,https://cloudflare-eth.com,https://eth-mainnet.public.blastapi.io,https://1rpc.io/eth,https://rpc.flashbots.net,https://endpoints.omniatech.io/v1/eth/mainnet/public
RPC_WS_URLS=wss://ethereum.publicnode.com,wss://eth.llamarpc.com
ETH_RPC_URLS=
ETH_WS_URLS=
LOG_LEVEL=info
