{
  "name": "@zig/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "6.0.3",
    "@zig/shared": "0.1.0",
    "ethers": "6.17.0",
    "fastify": "5.10.0",
    "nanoid": "5.1.5",
    "pg": "8.16.3",
    "pino": "9.7.0",
    "prom-client": "15.1.3",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.32",
    "@types/pg": "8.15.4",
    "eslint": "10.8.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  }
}
